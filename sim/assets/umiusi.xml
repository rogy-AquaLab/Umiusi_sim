<?xml version="1.0" encoding="UTF-8"?>
<!--
  UMIUSI azimuth-thruster ROV — lightweight MuJoCo model (primitives only, no meshes).
  Frame: CAD frame, +Y UP (thrusters lie in the X-Z plane). Units: SI, angles in degrees.

  Geometry is intentionally coarse (octahedron hull + cylinder thrusters) for speed; it
  affects only visuals/collision. Dynamics come from measured values:
    - hull: explicit measured mass + CoM + fullinertia (geom mass is therefore ignored).
    - thrusters: measured mass split over two cylinders (MuJoCo derives the inertia).
  Physical numbers live in configs/umiusi.yaml; keep the two files consistent.

  Collisions are disabled (contype/conaffinity = 0): the vehicle floats freely and is
  driven only by thrusters + analytical hydrodynamics applied in sim/simulator.py.
-->
<mujoco model="umiusi">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 -9.81 0" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <geom contype="0" conaffinity="0" rgba="0.3 0.3 0.35 1"/>  <!-- default (thrusters); hull overrides -->
    <!-- Servos: Hitec HS-646WP (waterproof, metal-gear). Modeled as a stiff position actuator
         with a real torque limit. kp=40 gives sub-degree holding (its deadband is ~4 us, i.e.
         <1 deg); forcerange = its stall torque (~0.94 N*m @6V .. ~1.14 N*m @7.4V, so +/-1.0 N*m).
         The thruster bodies are left under gravity on purpose (nearly-neutral hull, but the motor
         sinks): the ~0.58 N*m hinge load stays within the servo's stall torque, so it holds. -->
    <joint damping="0.15"/>
    <position kp="40.0" kv="2.0" forcerange="-1.0 1.0"/>
  </default>

  <asset>
    <!-- Octagonal-prism hull: an 8-sided octagon in the X-Z plane extruded along Y (height),
         16 vertices; MuJoCo builds the convex hull. Vertices span the full measured hull bbox
         (0.70196 x 0.220 x 0.52998 m, from CAD). The thrusters now reach out on arms, so the hull
         is drawn at true size (no shrink). Visual only; dynamics use the measured inertial. -->
    <mesh name="hull_prism"
          vertex="0.32426 0.11000 0.10141 0.32426 -0.11000 0.10141 0.13431 0.11000 0.24482
                  0.13431 -0.11000 0.24482 -0.13431 0.11000 0.24482 -0.13431 -0.11000 0.24482
                  -0.32426 0.11000 0.10141 -0.32426 -0.11000 0.10141 -0.32426 0.11000 -0.10141
                  -0.32426 -0.11000 -0.10141 -0.13431 0.11000 -0.24482 -0.13431 -0.11000 -0.24482
                  0.13431 0.11000 -0.24482 0.13431 -0.11000 -0.24482 0.32426 0.11000 -0.10141
                  0.32426 -0.11000 -0.10141"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 2 0" dir="0 -1 0" diffuse="0.8 0.8 0.8"/>
    <!-- Fixed cameras framed for the +Y-up CAD frame (MuJoCo's free camera assumes Z-up,
         so use these for an upright view in the GUI and for snapshots). -->
    <!-- Aimed at the vehicle center (~x=-0.23, not the world origin) and pulled back so the whole
         robot fits without clipping. xyaxes keeps +Y up for this Y-up model. -->
    <camera name="iso" pos="0.688 0.742 0.919" xyaxes="0.707 0 -0.707  -0.313 0.897 -0.313"/>
    <camera name="top" pos="-0.2 1.8 0" xyaxes="1 0 0  0 0 -1"/>
    <!-- Follows the vehicle CoM (keeps it centred and upright even as it drifts) — used by RL eval. -->
    <camera name="track" mode="trackcom" pos="0.92 0.65 0.92" xyaxes="0.707 0 -0.707  -0.313 0.897 -0.313"/>

    <!-- RL target-pose marker (mocap, kinematic, negligible mass, no collision). The RL env moves
         it to show the commanded orientation/position; parked far below by default so it stays out
         of the placement snapshots and the validation run. -->
    <body name="target_marker" mocap="true" pos="0 -10 0">
      <geom type="box" size="0.10 0.006 0.006" pos="0.10 0 0" rgba="1 0 0 0.7" contype="0" conaffinity="0" mass="0.0002"/>
      <geom type="box" size="0.006 0.10 0.006" pos="0 0.10 0" rgba="0.1 1 0.1 0.7" contype="0" conaffinity="0" mass="0.0002"/>
      <geom type="box" size="0.006 0.006 0.10" pos="0 0 0.10" rgba="0.2 0.5 1 0.7" contype="0" conaffinity="0" mass="0.0002"/>
    </body>

    <body name="base_link" pos="0 0 0">
      <freejoint name="floating_base"/>
      <!-- Measured inertial (overrides geom-derived inertia for this body). -->
      <inertial pos="-0.241053 0.093368 0.000327" mass="9.963939"
                fullinertia="0.1865 0.4736 0.3380 1.499e-4 4.590e-4 -8.78e-7"/>
      <!-- Coarse octagonal-prism hull, placed at the bbox center (visual only). -->
      <geom name="hull" type="mesh" mesh="hull_prism" pos="-0.23098 0.100 0.0" rgba="0.95 0.85 0.12 1"/>

      <!-- Azimuth thrusters (T-shaped ducted props), matching sinsei_umiusi_control's allocation:
           the servo tilts the thrust between HORIZONTAL (tangential, servo=0) and VERTICAL
           (servo=+90, up), i.e. phi = atan(f_vertical / f_horizontal). The hinge axis is the
           mounting ARM (joint -> prop, ~0.15 m, 45deg outboard + slight up); the ducted-prop
           barrel and thrust are perpendicular to it. Body pos = measured joint (CAD placement.txt);
           arm/thrust vectors derived from CAD. Geom mass ~0.63 kg/unit; MuJoCo derives inertia. -->
      <body name="thruster_1" pos="-0.02278 0.09815 -0.18722">
        <joint name="servo_1" type="hinge" axis="-0.70110 -0.11891 0.70308" range="-90 90"/>
        <geom name="t1_arm" type="cylinder" fromto="0 0 0  0.10436 0.01770 -0.10465" size="0.038" mass="0.13"/>
        <geom name="t1_duct" type="cylinder" fromto="0.04488 0.01770 -0.16397  0.16384 0.01770 -0.04534" size="0.049" mass="0.5"/>
        <site name="t1_thrust" pos="0.10436 0.01770 -0.10465" size="0.012" rgba="1 0 0 1"/>
      </body>

      <body name="thruster_2" pos="-0.39722 0.09815 -0.18722">
        <joint name="servo_2" type="hinge" axis="0.70110 -0.11891 0.70308" range="-90 90"/>
        <geom name="t2_arm" type="cylinder" fromto="0 0 0  -0.10436 0.01770 -0.10465" size="0.038" mass="0.13"/>
        <geom name="t2_duct" type="cylinder" fromto="-0.16384 0.01770 -0.04534  -0.04488 0.01770 -0.16397" size="0.049" mass="0.5"/>
        <site name="t2_thrust" pos="-0.10436 0.01770 -0.10465" size="0.012" rgba="1 0 0 1"/>
      </body>

      <body name="thruster_3" pos="-0.02278 0.09815 0.18722">
        <joint name="servo_3" type="hinge" axis="-0.70110 -0.11891 -0.70308" range="-90 90"/>
        <geom name="t3_arm" type="cylinder" fromto="0 0 0  0.10436 0.01770 0.10465" size="0.038" mass="0.13"/>
        <geom name="t3_duct" type="cylinder" fromto="0.16384 0.01770 0.04534  0.04488 0.01770 0.16397" size="0.049" mass="0.5"/>
        <site name="t3_thrust" pos="0.10436 0.01770 0.10465" size="0.012" rgba="1 0 0 1"/>
      </body>

      <body name="thruster_4" pos="-0.39722 0.09815 0.18722">
        <joint name="servo_4" type="hinge" axis="0.70110 -0.11891 -0.70308" range="-90 90"/>
        <geom name="t4_arm" type="cylinder" fromto="0 0 0  -0.10436 0.01770 0.10465" size="0.038" mass="0.13"/>
        <geom name="t4_duct" type="cylinder" fromto="-0.04488 0.01770 0.16397  -0.16384 0.01770 0.04534" size="0.049" mass="0.5"/>
        <site name="t4_thrust" pos="-0.10436 0.01770 0.10465" size="0.012" rgba="1 0 0 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="servo_1" joint="servo_1" ctrlrange="-90 90"/>
    <position name="servo_2" joint="servo_2" ctrlrange="-90 90"/>
    <position name="servo_3" joint="servo_3" ctrlrange="-90 90"/>
    <position name="servo_4" joint="servo_4" ctrlrange="-90 90"/>
  </actuator>
</mujoco>
